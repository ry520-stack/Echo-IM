# ============================================================
# Echo IM 环境变量模板
#
# 使用方法：
#   1. 复制此文件为 backend/.env
#   2. 填入实际配置值
#   3. 不要将 .env 文件提交到 Git
#
# 生成密钥命令：
#   JWT_SECRET: openssl rand -hex 32
#   DB_PASSWORD: openssl rand -base64 16
# ============================================================

# ── 数据库配置 ──
# PostgreSQL 连接字符串
DATABASE_URL=postgresql://echo_user:你的数据库密码@db:5432/echo_db
DB_USER=echo_user
DB_PASSWORD=你的数据库密码
DB_NAME=echo_db

# ── JWT 配置 ──
# 用于用户认证的密钥（必须保密）
JWT_SECRET=你的JWT密钥_至少32位随机字符串
JWT_EXPIRES_IN=7d

# ── 服务端口 ──
PORT=3001

# ── 前端地址 ──
# 用于 CORS 跨域配置
FRONTEND_URL=https://你的域名

# ── 邮件配置（可选） ──
# Resend 邮件服务 API Key
RESEND_API_KEY=

# SMTP 配置
SMTP_USER=
SMTP_PASS=

# QQ 邮箱 SMTP
QQ_SMTP_USER=
QQ_SMTP_PASS=

# ── 推送配置（可选） ──
# UniPush 推送服务
UNIPUSH_WEBHOOK_URL=
UNIPUSH_WEBHOOK_SECRET=
OFFLINE_PUSH_ENABLED=false

# ── 地图服务（可选） ──
# 高德地图 Web 服务 Key
AMAP_WEB_SERVICE_KEY=
